<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.example.galleryapp.AlbumController"
            prefWidth="1000.0"
            prefHeight="700.0"
            style="-fx-background-color: #292929;">


    <children>

        <VBox spacing="15"
              AnchorPane.topAnchor="20"
              AnchorPane.leftAnchor="25"
              AnchorPane.rightAnchor="25"
              AnchorPane.bottomAnchor="20">

            <!-- ÜST KISIM -->

            <VBox spacing="5">

                <Label text="Albums"
                       style="-fx-font-size: 28px;
                       -fx-font-weight: bold;
                       -fx-text-fill: white;"/>


                <Label text="Fotoğraf ve videolarınızı albümlerde düzenleyin."
                       style="-fx-text-fill: #888888; -fx-font-size: 14px;"/>

            </VBox>

            <Button text="← Geri"
                    onAction="#goBack"
                    prefHeight="35"
                    style="-fx-background-color: #3A3A3A;
                    -fx-text-fill: white;
                    -fx-font-size: 14px;
                    fx-background-radius: 10px;
                    -fx-padding: 8px 18px;"/>


            <!-- ALBÜM OLUŞTUR BUTONU -->

            <Button text=" Yeni Albüm"
                    onAction="#createAlbum"
                    prefHeight="35"
                    style="-fx-background-color: #3A3A3A;
                           -fx-text-fill: white;
                           -fx-font-size: 14px;
                           -fx-background-radius: 10px;
                           -fx-padding: 8px 18px;"/>


            <!-- ALBÜMLER -->

            <ScrollPane fitToWidth="true"
                        VBox.vgrow="ALWAYS"
                        style="-fx-background-color: #292929;
                               -fx-border-color : transparent;
                               -fx-background: #292929;">




                <content>

                    <FlowPane fx:id="albumPane"
                              hgap="20"
                              vgap="25"
                              prefWrapLength="900"
                              style ="-fx-background-color: #292929;
                                      -fx-padding: 20px;"/>


                </content>

            </ScrollPane>


            <!-- ALBÜM YOKSA -->

            <Label fx:id="emptyLabel"
                   text="Henüz albüm oluşturmadınız."
                   visible="false"
                   managed="false"
                   style="-fx-text-fill: #888888;
                          -fx-font-size: 15px;"/>

        </VBox>

    </children>

</AnchorPane>
